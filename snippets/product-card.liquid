<a class="card" href="{{ product.url }}">
  <div class="card__media">

    {% if product.featured_image %}
      {{
        product.featured_image
        | image_url: width: 800
        | image_tag:
          loading: 'lazy',
          alt: product.title
      }}
    {% endif %}

    {% if product.compare_at_price > product.price %}
      {% assign off = product.compare_at_price
        | minus: product.price
        | times: 100.0
        | divided_by: product.compare_at_price
        | round
      %}

      <span class="card__badge">
        {{ off }}% OFF
      </span>
    {% endif %}

  </div>

  <h3 class="card__title">
    {{ product.title }}
  </h3>

  <p class="card__price">

    {% if product.compare_at_price > product.price %}

      {% assign compare_lei = product.compare_at_price | divided_by: 100 %}
      {% assign compare_bani = product.compare_at_price | modulo: 100 %}

      <s>
        {{ compare_lei }}{% if compare_bani > 0 %},{% if compare_bani < 10 %}0{% endif %}{{ compare_bani }}{% endif %} lei
      </s>

    {% endif %}

    {% assign price_lei = product.price | divided_by: 100 %}
    {% assign price_bani = product.price | modulo: 100 %}

    <span>
      {{ price_lei }}{% if price_bani > 0 %},{% if price_bani < 10 %}0{% endif %}{{ price_bani }}{% endif %} lei
    </span>

  </p>

  {% unless product.available %}
    <p class="card__soldout">
      Sold out
    </p>
  {% endunless %}

</a>