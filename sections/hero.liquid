<section class="hero">
  {% if section.settings.image %}
    {{ section.settings.image | image_url: width: 1920 | image_tag: class: 'hero__img', alt: section.settings.heading }}
  {% else %}
    <img class="hero__img" src="{{ 'hero.jpg' | asset_url }}" alt="{{ section.settings.heading }}" width="1920" height="900">
  {% endif %}
  <div class="hero__body">
    <h1 class="hero__title">{{ section.settings.heading }}</h1>
    {% if section.settings.button_label != blank %}
      <a class="btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "UP TO NO GOOD" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the drop" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}