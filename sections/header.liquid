<header class="header">
  <div class="header__inner">
    <button class="header__burger icon-btn" type="button" aria-label="Open menu" data-open="mobile-menu">
      <svg class="icon" viewBox="0 0 24 24"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
    </button>

    <a class="header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
      {% if section.settings.logo %}
        {{ section.settings.logo | image_url: width: 400 | image_tag: alt: shop.name, height: 140 }}
      {% else %}
        <img src="{{ 'mischief-logo.png' | asset_url }}" alt="{{ shop.name }}" width="200" height="70">
      {% endif %}
    </a>

    <nav class="header__nav">
      {% for link in linklists[section.settings.menu].links %}
        <div class="header__item">
          <a class="header__link" href="{{ link.url }}">
            {{ link.title }}
            {% if link.links.size > 0 %}
              <svg class="icon" style="width:14px;height:14px" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
            {% endif %}
          </a>
          {% if link.links.size > 0 %}
            <div class="header__menu">
              <ul>
                {% for child in link.links %}
                  <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </nav>

    <div class="header__actions">
      <button class="icon-btn" type="button" aria-label="Search" data-open="search-overlay">
        <svg class="icon" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </button>
      <a class="icon-btn" href="{{ routes.account_url }}" aria-label="Account">
        <svg class="icon" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6 8-6s8 2 8 6"/></svg>
      </a>
      <a class="icon-btn" href="{{ routes.cart_url }}" aria-label="Cart">
        <svg class="icon" viewBox="0 0 24 24"><path d="M6 6h15l-1.5 9H7.5L6 6Z"/><circle cx="9" cy="20" r="1.5"/><circle cx="18" cy="20" r="1.5"/><path d="M6 6 5 3H3"/></svg>
        {% if cart.item_count > 0 %}<span class="cart-count">{{ cart.item_count }}</span>{% endif %}
      </a>
    </div>
  </div>
</header>

<div class="overlay" id="search-overlay" hidden>
  <div style="max-width:900px;margin:0 auto">
    <div class="overlay__head">
      <h2 class="section__title">Search</h2>
      <button type="button" aria-label="Close search" data-close="search-overlay">
        <svg class="icon" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
    </div>
    <form action="{{ routes.search_url }}" method="get" role="search">
      <input class="search__input" type="search" name="q" placeholder="Search products" value="{{ search.terms | escape }}">
      <button class="btn" style="margin-top:24px" type="submit">Search</button>
    </form>
  </div>
</div>

<div class="overlay" id="mobile-menu" hidden>
  <div class="overlay__head">
    <img src="{{ 'mischief-logo.png' | asset_url }}" alt="{{ shop.name }}" style="height:28px;width:auto">
    <button type="button" aria-label="Close menu" data-close="mobile-menu">
      <svg class="icon" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
  </div>
  <ul style="margin-top:24px;display:grid;gap:16px">
    {% for link in linklists[section.settings.menu].links %}
      <li>
        <a class="header__link" href="{{ link.url }}">{{ link.title }}</a>
        {% if link.links.size > 0 %}
          <ul style="margin-top:8px;padding-left:12px;display:grid;gap:8px">
            {% for child in link.links %}
              <li><a class="muted" style="font-size:12px;text-transform:uppercase" href="{{ child.url }}">{{ child.title }}</a></li>
            {% endfor %}
          </ul>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
  ]
}
{% endschema %}