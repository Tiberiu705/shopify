<section class="story">
  <div class="section__head">
    <h2 class="section__title">{{ section.settings.title }}</h2>
    <p class="section__sub" style="opacity:0.7">{{ section.settings.subtitle }}</p>
  </div>
  <ul class="story__list">
    {% for block in section.blocks %}
      <li class="story__item" {{ block.shopify_attributes }}>
        <h3>{{ block.settings.heading }}</h3>
        <p>{{ block.settings.body }}</p>
      </li>
    {% endfor %}
  </ul>
</section>

{% schema %}
{
  "name": "Story",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "How we make it" },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Three rules we do not bend, whatever the drop looks like."
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Rule",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Made heavy" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "Every piece is cut from dense, structured cotton with real weight to it." }
      ]
    }
  ],
  "presets": [{ "name": "Story" }]
}
{% endschema %}