<section class="product">
  <nav class="breadcrumb">
    <a href="{{ routes.root_url }}">Home</a><span>/</span><span style="color:var(--foreground)">{{ product.title }}</span>
  </nav>

  <div class="product__layout">
    <div data-gallery>
      <div class="gallery__main">
        <img data-gallery-main src="{{ product.featured_image | image_url: width: 1200 }}" alt="{{ product.title | escape }}" width="900" height="900">
      </div>
      {% if product.images.size > 1 %}
        <div class="gallery__thumbs">
          {% for image in product.images %}
            <button type="button" data-thumb="{{ image | image_url: width: 1200 }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">
              <img src="{{ image | image_url: width: 200 }}" alt="" loading="lazy">
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="product__info">
      <h1 class="product__title">{{ product.title }}</h1>

      {% form 'product', product, data-product-form: '', data-money-format: shop.money_format %}
        <div class="product__price">
          <s data-compare-price {% unless product.compare_at_price > product.price %}hidden{% endunless %}>{{ product.compare_at_price | money }}</s>
          <span data-price>{{ product.price | money }}</span>
        </div>

        <hr class="rule">

        {% unless product.has_only_default_variant %}
          {% for option in product.options_with_values %}
            <div class="option" data-option-index="{{ forloop.index0 }}">
              <div class="option__head">
                <span>{{ option.name }} <strong data-option-value>{{ option.selected_value }}</strong></span>
                {% if option.name contains 'Marime' or option.name contains 'Mărime' or option.name contains 'Size' %}
                  <a style="color:var(--primary);text-decoration:underline;font-size:12px" href="{{ pages['size-guide'].url | default: '/pages/size-guide' }}">Size guide</a>
                {% endif %}
              </div>
              <div class="option__values">
                {% for value in option.values %}
                  <button class="swatch" type="button" data-value="{{ value | escape }}" aria-pressed="{% if value == option.selected_value %}true{% else %}false{% endif %}">{{ value }}</button>
                {% endfor %}
              </div>
            </div>
          {% endfor %}
        {% endunless %}

        <div class="row-between">
          <span>Quantity</span>
          <div class="qty">
            <button type="button" data-qty="-1" aria-label="Decrease quantity">&minus;</button>
            <input type="number" name="quantity" value="1" min="1" inputmode="numeric">
            <button type="button" data-qty="1" aria-label="Increase quantity">+</button>
          </div>
        </div>

        <input type="hidden" name="id" data-variant-id value="{{ product.selected_or_first_available_variant.id }}">
        <button class="btn btn--block" style="margin-top:24px" type="submit" data-submit {% unless product.available %}disabled{% endunless %}>
          {% if product.available %}Add to cart{% else %}Sold out{% endif %}
        </button>

        <script type="application/json" data-variants>
          [
            {% for variant in product.variants %}
              {
                "id": {{ variant.id }},
                "options": {{ variant.options | json }},
                "price": {{ variant.price }},
                "compare_at_price": {{ variant.compare_at_price | default: 0 }},
                "available": {{ variant.available }}
              }{% unless forloop.last %},{% endunless %}
            {% endfor %}
          ]
        </script>
      {% endform %}

      <div class="accordions">
        <div class="accordion">
          <button class="accordion__btn" type="button">Product details <span>+</span></button>
          <div class="accordion__body rte" hidden>{{ product.description }}</div>
        </div>
        <div class="accordion">
          <button class="accordion__btn" type="button">Shipping &amp; returns <span>+</span></button>
          <div class="accordion__body" hidden>
            {{ section.settings.shipping_text }}
          </div>
        </div>
      </div>
    </div>
  </div>

  {% assign related = collections.all.products %}
  {% if related.size > 1 %}
    <div class="section" style="padding-left:0;padding-right:0">
      <h2 class="section__title" style="margin-bottom:24px">You might also like</h2>
      <div class="row-scroll">
        {% for item in related limit: 10 %}
          {% unless item.handle == product.handle %}
            <div>{% render 'product-card', product: item %}</div>
          {% endunless %}
        {% endfor %}
      </div>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Product",
  "settings": [
    {
      "type": "textarea",
      "id": "shipping_text",
      "label": "Shipping text",
      "default": "Delivery and return options are confirmed at checkout. Unworn pieces can be returned within 30 days of delivery with tags attached."
    }
  ]
}
{% endschema %}