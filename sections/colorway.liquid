{% assign featured_product = section.settings.product %}

{% if featured_product != blank %}
  {% assign current_variant = featured_product.selected_or_first_available_variant %}

  <section
    class="home-product"
    id="HomeProduct-{{ section.id }}"
    data-home-product
  >
    <div class="home-product__inner">

      <div class="home-product__visual">

        <div class="home-product__image-box">

          <span class="glass-corner glass-corner--tl"></span>
          <span class="glass-corner glass-corner--tr"></span>
          <span class="glass-corner glass-corner--bl"></span>
          <span class="glass-corner glass-corner--br"></span>

          {% if featured_product.featured_image %}
            <img
              class="home-product__image"
              data-product-image
              src="{{ featured_product.featured_image | image_url: width: 1400 }}"
              alt="{{ featured_product.title | escape }}"
              loading="lazy"
              width="1000"
              height="1000"
            >
          {% endif %}

          {% if current_variant.compare_at_price > current_variant.price %}
            {% assign discount = current_variant.compare_at_price
              | minus: current_variant.price
              | times: 100.0
              | divided_by: current_variant.compare_at_price
              | round
            %}

            <div class="home-product__discount">
              {{ discount }}% OFF
            </div>
          {% endif %}

        </div>

      </div>

      <div class="home-product__content">

        <div class="home-product__eyebrow">
          FEATURED DROP
        </div>

        <h2 class="home-product__title">
          {{ featured_product.title }}
        </h2>

        <div class="home-product__price">

          {% if current_variant.compare_at_price > current_variant.price %}
            <s data-home-compare>
              {% assign old_lei = current_variant.compare_at_price | divided_by: 100 %}
              {% assign old_bani = current_variant.compare_at_price | modulo: 100 %}

              {{ old_lei }}{% if old_bani > 0 %},{% if old_bani < 10 %}0{% endif %}{{ old_bani }}{% endif %} lei
            </s>
          {% else %}
            <s data-home-compare hidden></s>
          {% endif %}

          <span data-home-price>
            {% assign price_lei = current_variant.price | divided_by: 100 %}
            {% assign price_bani = current_variant.price | modulo: 100 %}

            {{ price_lei }}{% if price_bani > 0 %},{% if price_bani < 10 %}0{% endif %}{{ price_bani }}{% endif %} lei
          </span>

        </div>

        {% if featured_product.description != blank %}
          <div class="home-product__description">
            {{ featured_product.description | strip_html | truncatewords: 28 }}
          </div>
        {% endif %}

        <div class="home-product__divider"></div>

        {% unless featured_product.has_only_default_variant %}

          <div class="home-product__options">

            {% for option in featured_product.options_with_values %}

              <div
                class="home-option"
                data-home-option
                data-option-index="{{ forloop.index0 }}"
              >

                <div class="home-option__head">
                  <span>{{ option.name }}</span>

                  <strong data-home-option-value>
                    {{ option.selected_value }}
                  </strong>
                </div>

                <div class="home-option__values">

                  {% for value in option.values %}

                    <button
                      type="button"
                      class="home-option__button"
                      data-home-value="{{ value | escape }}"
                      aria-pressed="{% if value == option.selected_value %}true{% else %}false{% endif %}"
                    >
                      {{ value }}
                    </button>

                  {% endfor %}

                </div>

              </div>

            {% endfor %}

          </div>

        {% endunless %}

        <div class="home-product__stock">
          <span
            class="home-product__stock-dot"
            data-stock-dot
          ></span>

          <span data-home-stock>
            {% if current_variant.available %}
              În stoc
            {% else %}
              Stoc epuizat
            {% endif %}
          </span>
        </div>

        <div class="home-product__buy">

          <div class="home-product__quantity">

            <button
              type="button"
              data-home-qty-minus
              aria-label="Scade cantitatea"
            >
              −
            </button>

            <input
              type="number"
              value="1"
              min="1"
              data-home-quantity
              aria-label="Cantitate"
            >

            <button
              type="button"
              data-home-qty-plus
              aria-label="Crește cantitatea"
            >
              +
            </button>

          </div>

          <button
            type="button"
            class="home-product__add"
            data-home-add
            {% unless current_variant.available %}disabled{% endunless %}
          >
            {% if current_variant.available %}
              ADD TO CART
            {% else %}
              SOLD OUT
            {% endif %}
          </button>

        </div>

        <div class="home-product__benefits">

          <div>
            <span>01</span>
            Livrare rapidă
          </div>

          <div>
            <span>02</span>
            Plată securizată
          </div>

          <div>
            <span>03</span>
            Retur simplu
          </div>

        </div>

        <a
          href="{{ featured_product.url }}"
          class="home-product__details"
        >
          VIEW FULL PRODUCT DETAILS →
        </a>

      </div>

    </div>

    <script type="application/json" data-home-variants>
      [
        {% for variant in featured_product.variants %}
          {
            "id": {{ variant.id }},
            "options": {{ variant.options | json }},
            "price": {{ variant.price }},
            "compare_at_price": {{ variant.compare_at_price | default: 0 }},
            "available": {{ variant.available | json }},
            "image": {% if variant.featured_image %}{{ variant.featured_image | image_url: width: 1400 | json }}{% elsif featured_product.featured_image %}{{ featured_product.featured_image | image_url: width: 1400 | json }}{% else %}null{% endif %}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    </script>

  </section>

  <script>
    document.addEventListener('DOMContentLoaded', function () {

      const section = document.querySelector('#HomeProduct-{{ section.id }}');

      if (!section) {
        return;
      }

      const variantsData = section.querySelector('[data-home-variants]');
      const price = section.querySelector('[data-home-price]');
      const compare = section.querySelector('[data-home-compare]');
      const image = section.querySelector('[data-product-image]');
      const addButton = section.querySelector('[data-home-add]');
      const stock = section.querySelector('[data-home-stock]');
      const stockDot = section.querySelector('[data-stock-dot]');
      const quantity = section.querySelector('[data-home-quantity]');

      let variants = [];

      try {
        variants = JSON.parse(variantsData.textContent);
      } catch (error) {
        console.error(error);
      }

      function formatLei(cents) {

        cents = Number(cents || 0);

        const lei = Math.floor(cents / 100);
        const bani = cents % 100;

        if (bani === 0) {
          return lei + ' lei';
        }

        return lei + ',' + String(bani).padStart(2, '0') + ' lei';
      }

      function selectedOptions() {

        const values = [];

        section.querySelectorAll('[data-home-option]').forEach(function (group) {

          const selected = group.querySelector(
            '[data-home-value][aria-pressed="true"]'
          );

          if (selected) {
            values.push(selected.dataset.homeValue);
          }

        });

        return values;
      }

      function getVariant() {

        const selected = selectedOptions();

        if (selected.length === 0 && variants.length === 1) {
          return variants[0];
        }

        return variants.find(function (variant) {

          return variant.options.every(function (option, index) {
            return String(option) === String(selected[index]);
          });

        });

      }

      function updateVariant() {

        const variant = getVariant();

        if (!variant) {

          addButton.disabled = true;
          addButton.textContent = 'UNAVAILABLE';

          stock.textContent = 'Indisponibil';

          return;
        }

        price.textContent = formatLei(variant.price);

        if (
          variant.compare_at_price &&
          Number(variant.compare_at_price) > Number(variant.price)
        ) {

          compare.hidden = false;
          compare.textContent = formatLei(variant.compare_at_price);

        } else {

          compare.hidden = true;
          compare.textContent = '';

        }

        if (variant.image && image) {
          image.src = variant.image;
        }

        if (variant.available) {

          addButton.disabled = false;
          addButton.textContent = 'ADD TO CART';

          stock.textContent = 'În stoc';
          stockDot.classList.remove('is-sold-out');

        } else {

          addButton.disabled = true;
          addButton.textContent = 'SOLD OUT';

          stock.textContent = 'Stoc epuizat';
          stockDot.classList.add('is-sold-out');

        }

      }

      section.querySelectorAll('[data-home-value]').forEach(function (button) {

        button.addEventListener('click', function () {

          const group = button.closest('[data-home-option]');

          group.querySelectorAll('[data-home-value]').forEach(function (item) {
            item.setAttribute('aria-pressed', 'false');
          });

          button.setAttribute('aria-pressed', 'true');

          const label = group.querySelector('[data-home-option-value]');

          if (label) {
            label.textContent = button.dataset.homeValue;
          }

          updateVariant();

        });

      });

      section
        .querySelector('[data-home-qty-minus]')
        .addEventListener('click', function () {

          const current = Number(quantity.value) || 1;

          quantity.value = Math.max(1, current - 1);

        });

      section
        .querySelector('[data-home-qty-plus]')
        .addEventListener('click', function () {

          const current = Number(quantity.value) || 1;

          quantity.value = current + 1;

        });

      addButton.addEventListener('click', async function () {

        const variant = getVariant();

        if (!variant || !variant.available) {
          return;
        }

        const amount = Math.max(
          1,
          Number(quantity.value) || 1
        );

        addButton.disabled = true;
        addButton.textContent = 'ADDING...';

        try {

          const response = await fetch(
            window.Shopify.routes.root + 'cart/add.js',
            {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json'
              },
              body: JSON.stringify({
                items: [
                  {
                    id: variant.id,
                    quantity: amount
                  }
                ]
              })
            }
          );

          if (!response.ok) {
            throw new Error('Cart error');
          }

          addButton.textContent = 'ADDED TO CART ✓';

          try {

            const cartResponse = await fetch(
              window.Shopify.routes.root + 'cart.js'
            );

            const cart = await cartResponse.json();

            document.querySelectorAll('.cart-count').forEach(function (counter) {
              counter.textContent = cart.item_count;
              counter.hidden = false;
            });

          } catch (error) {
            console.error(error);
          }

          setTimeout(function () {
            addButton.disabled = false;
            addButton.textContent = 'ADD TO CART';
          }, 1500);

        } catch (error) {

          addButton.disabled = false;
          addButton.textContent = 'TRY AGAIN';

        }

      });

      updateVariant();

    });
  </script>

{% endif %}

{% schema %}
{
  "name": "Homepage product",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Produs"
    }
  ],
  "presets": [
    {
      "name": "Homepage product"
    }
  ]
}
{% endschema %}