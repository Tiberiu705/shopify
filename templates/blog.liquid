<section class="section">
  <div class="section__head"><h1 class="section__title">{{ blog.title }}</h1></div>
  <div class="grid">
    {% for article in blog.articles %}
      <a class="card" href="{{ article.url }}">
        <div class="card__media">
          {% if article.image %}{{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: article.title }}{% endif %}
        </div>
        <h2 class="card__title">{{ article.title }}</h2>
        <p class="muted" style="font-size:12px">{{ article.published_at | date: '%d %b %Y' }}</p>
      </a>
    {% endfor %}
  </div>
</section>