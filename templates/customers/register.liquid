<section class="page">
  <h1 class="page__title">Create account</h1>
  {% form 'create_customer' %}
    {{ form.errors | default_errors }}
    <input class="search__input" type="text" name="customer[first_name]" placeholder="First name">
    <input class="search__input" type="text" name="customer[last_name]" placeholder="Last name">
    <input class="search__input" type="email" name="customer[email]" placeholder="Email" required>
    <input class="search__input" type="password" name="customer[password]" placeholder="Password" required>
    <button class="btn btn--block" style="margin-top:24px" type="submit">Create</button>
  {% endform %}
</section>